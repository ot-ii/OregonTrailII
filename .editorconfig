root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = tab
trim_trailing_whitespace = true

[*.{md,sh}]
indent_style = space
indent_size = 2

[*.{yml,astro}]
indent_style = space
indent_size = 2

[*.js]
indent_style = tab
indent_size = 4

[*.{c,cpp,go,nsh,nsi}]
indent_style = tab
indent_size = 4
insert_final_newline = true

[{makefile,GNUmakefile}]
insert_final_newline = true
